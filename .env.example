DEEPSEEK_API_KEY=sk-1a4028e7f3494885b5e38698c4bf8e44
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Database (SQLite for Phase 0)
DATABASE_URL=sqlite:///./nutrihealth.db

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Backend
BACKEND_PORT=8000

# ====== Frontend (demo 模式) ======
# 设为 local 启用纯前端 demo 模式（浏览器直连 DeepSeek + IndexedDB 存储）
# 不设置或设为其他值则对接现有后端（remote 模式）
# NEXT_PUBLIC_DEMO_MODE=local

# demo 模式下的默认 API key（可选，会明文打进静态产物，仅限内部 demo）
# NEXT_PUBLIC_DEEPSEEK_API_KEY=sk-xxxx

# remote 模式的后端地址
NEXT_PUBLIC_API_URL=http://localhost:8000
